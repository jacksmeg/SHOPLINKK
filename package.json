{
  "name": "shoplinkk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "start:prod:local": "set \"NEXTAUTH_URL=http://localhost:3004\"&& set \"NEXT_PUBLIC_APP_URL=http://localhost:3004\"&& next start -p 3004",
    "start:lan": "powershell -ExecutionPolicy Bypass -File scripts/start-lan.ps1",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed-production.ts",
    "db:seed:demo": "tsx prisma/seed.ts",
    "db:cleanup:demo": "tsx scripts/cleanup-demo-data.ts",
    "db:studio": "prisma studio",
    "secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\"",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "check:prod": "tsx scripts/production-check.ts",
    "backup:db": "powershell -ExecutionPolicy Bypass -File scripts/backup-postgres.ps1"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
