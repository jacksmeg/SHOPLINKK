DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shoplinkk?schema=public"
NEXTAUTH_URL="http://localhost:3004"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
INTEGRATION_ENCRYPTION_KEY="replace-with-a-second-long-random-secret"

# Google OAuth: create credentials in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_MAPS_API_KEY=""

# Production seed credentials. Do not use a shared demo password.
SHOPLINKK_ADMIN_EMAIL="admin@shoplinkk.com"
SHOPLINKK_ADMIN_PASSWORD=""

# Email provider. Resend-compatible by default; leave blank in local demo.
EMAIL_FROM="ShopLinkk <no-reply@shoplinkk.com>"
RESEND_API_KEY=""

# Cloudinary signed uploads. If blank, local public/uploads is used only in development.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
TINIFY_API_KEY=""

# Production deployment URL used in emails and SEO.
NEXT_PUBLIC_APP_URL="http://localhost:3004"

# Browser push notifications. Generate with: npm run push:keys
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:hello@shoplinkk.com"

# Arkesel OTP for Ghana phone-number verification.
ARKESEL_API_KEY=""
ARKESEL_SENDER_ID="ShopLinkk"

# Admin/ops alerts.
ADMIN_ALERT_EMAIL=""
LOG_WEBHOOK_URL=""
CRON_SECRET=""

# Optional future real-time provider keys for replacing polling chat.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""
