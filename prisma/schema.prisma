generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  RIDER
  ADMIN
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum ListingType {
  PRODUCT
  SERVICE
}

enum PriceMode {
  FIXED
  CONTACT
}

enum StockStatus {
  AVAILABLE
  SOLD
  OUT_OF_STOCK
}

enum ListingStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
}

enum SellerVerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  SYSTEM
  MESSAGE
  LISTING
  REPORT
  REVIEW
  SECURITY
  PRICE_ALERT
  BOOST
  DELIVERY
}

enum AuditAction {
  USER_BLOCKED
  USER_UNBLOCKED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  PRODUCT_REMOVED
  SELLER_VERIFIED
  SELLER_REJECTED
  REPORT_RESOLVED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  ADMIN_NOTE_CREATED
  INTEGRATION_UPDATED
  PLATFORM_SETTINGS_UPDATED
  TOWN_CREATED
  TOWN_UPDATED
  BOOST_APPROVED
  BOOST_REJECTED
  RIDER_APPROVED
  RIDER_REJECTED
  RIDER_SUSPENDED
  DELIVERY_ASSIGNED
}

enum IntegrationProvider {
  GOOGLE_OAUTH
  RESEND
  CLOUDINARY
  TINIFY
  TWILIO
  ARKESEL
  PUSHER
  GOOGLE_MAPS
  PAYSTACK
  KORA
  HUBTEL
  CLOUDFLARE_TURNSTILE
  WEB_PUSH
  MONITORING
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  CONNECTED
  ERROR
}

enum DeletionStatus {
  REQUESTED
  REVIEWED
  COMPLETED
  CANCELLED
}

enum PriceAlertStatus {
  ACTIVE
  TRIGGERED
  CANCELLED
}

enum ProductBoostStatus {
  REQUESTED
  APPROVED
  REJECTED
  ENDED
}

enum AdvertPlacement {
  HOMEPAGE
  MARKETPLACE
}

enum AdvertPaymentStatus {
  PENDING
  CONFIRMED
  WAIVED
  REFUNDED
}

enum ListingPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  WAIVED
}

enum BillingProvider {
  PAYSTACK
  KORA
  HUBTEL
}

enum BillingPackageType {
  PRODUCT_LISTING
  ADVERT
}

enum BillingPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum PaymentPurpose {
  PRODUCT_LISTING
  ADVERT
}

enum AdvertExtensionStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
}

enum StoreKind {
  GENERAL
  FOOD
}

enum FoodOrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DirectPaymentStatus {
  AWAITING_PAYMENT
  SUBMITTED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum MarketplaceOrderStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  PAID
  READY
  DELIVERED
  CANCELLED
}

enum FoodMenuStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum RiderVerificationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum RiderAvailability {
  OFFLINE
  ONLINE
  BUSY
  ON_DELIVERY
}

enum RiderVehicleType {
  MOTORCYCLE
  TRICYCLE
  CAR
  VAN
}

enum DeliveryRequestStatus {
  OPEN
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum DeliveryStatus {
  WAITING_FOR_RIDER
  ACCEPTED
  HEADING_TO_SELLER
  ITEM_PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum DeliveryReportReason {
  LATE_DELIVERY
  MISSING_ITEM
  DAMAGED_PACKAGE
  RIDER_MISCONDUCT
  OTHER
}

model User {
  id                       String                   @id @default(cuid())
  name                     String?
  email                    String?                  @unique
  username                 String?                  @unique
  emailVerified            DateTime?
  phoneVerifiedAt          DateTime?
  image                    String?
  passwordHash             String?
  role                     Role                     @default(BUYER)
  phone                    String?                  @unique
  whatsapp                 String?
  location                 String                   @default("Dunkwa-on-Offin")
  area                     String?
  bio                      String?
  isBlocked                Boolean                  @default(false)
  suspensionReason         String?
  deleteRequestedAt        DateTime?
  termsAcceptedAt          DateTime?
  termsVersion             String?
  lastLoginAlertAt         DateTime?
  emailAlertsEnabled       Boolean                  @default(true)
  pushNotificationsEnabled Boolean                  @default(true)
  lastActiveAt             DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  accounts                 Account[]
  sessions                 Session[]
  store                    Store?
  products                 Product[]                @relation("SellerProducts")
  favorites                Favorite[]
  favoriteFolders          FavoriteFolder[]
  sentMessages             Message[]                @relation("SentMessages")
  conversationsBuyer       Conversation[]           @relation("BuyerConversations")
  conversationsSeller      Conversation[]           @relation("SellerConversations")
  reportsMade              Report[]                 @relation("Reporter")
  reportsAgainst           Report[]                 @relation("ReportedUser")
  reviewedReports          Report[]                 @relation("ReportReviewer")
  blocksMade               BlockedUser[]            @relation("BlockedBy")
  blocksReceived           BlockedUser[]            @relation("BlockedTarget")
  sellerVerifications      SellerVerification[]     @relation("SellerVerificationSeller")
  reviewedVerifications    SellerVerification[]     @relation("SellerVerificationReviewer")
  reviewsGiven             Review[]                 @relation("ReviewAuthor")
  reviewsReceived          Review[]                 @relation("ReviewSeller")
  notifications            Notification[]
  pushSubscriptions        PushSubscription[]
  savedSearches            SavedSearch[]
  comparedProducts         ComparedProduct[]
  priceAlerts              PriceAlert[]
  recentlyViewed           RecentlyViewed[]
  productViews             ProductView[]
  followedStores           StoreFollower[]          @relation("StoreFollowerUser")
  chatTypingStatuses       ChatTypingStatus[]
  adminNotesAuthored       AdminNote[]              @relation("AdminNoteAuthor")
  adminNotesReceived       AdminNote[]              @relation("AdminNoteTarget")
  auditLogs                AdminAuditLog[]          @relation("AuditActor")
  deletionRequests         AccountDeletionRequest[]
  messageAttachments       ChatAttachment[]
  boostRequests            ProductBoostRequest[]    @relation("BoostRequester")
  reviewedBoostRequests    ProductBoostRequest[]    @relation("BoostReviewer")
  integrationsUpdated      IntegrationSetting[]     @relation("IntegrationUpdatedBy")
  platformSettings         PlatformSetting[]        @relation("PlatformSettingUpdatedBy")
  paymentTransactions      PaymentTransaction[]     @relation("PaymentUser")
  billingPackagesUpdated   BillingPackage[]         @relation("BillingPackageUpdatedBy")
  trustedDevices           TrustedDevice[]
  riderProfile             RiderProfile?            @relation("RiderUser")
  reviewedRiders           RiderProfile[]           @relation("RiderReviewer")
  deliveryRequestsAsSeller DeliveryRequest[]        @relation("DeliveryRequestSeller")
  deliveryRequestsAsBuyer  DeliveryRequest[]        @relation("DeliveryRequestBuyer")
  deliveriesAsSeller       Delivery[]               @relation("DeliverySeller")
  deliveriesAsBuyer        Delivery[]               @relation("DeliveryBuyer")
  riderRatingsGiven        RiderRating[]            @relation("RiderRatingAuthor")
  deliveryReportsMade      DeliveryReport[]         @relation("DeliveryReportReporter")
  deliveryReportsReviewed  DeliveryReport[]         @relation("DeliveryReportReviewer")
  foodOrders               FoodOrder[]              @relation("FoodOrderBuyer")
  marketplaceOrdersBuyer   MarketplaceOrder[]       @relation("MarketplaceOrderBuyer")
  marketplaceOrdersSeller  MarketplaceOrder[]       @relation("MarketplaceOrderSeller")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Store {
  id                   String                   @id @default(cuid())
  ownerId              String                   @unique
  name                 String
  slug                 String                   @unique
  kind                 StoreKind                @default(GENERAL)
  description          String?
  email                String?
  phone                String?
  whatsapp             String?
  momoNumber           String?
  location             String                   @default("Dunkwa-on-Offin")
  area                 String?
  address              String?
  gpsLatitude          Float?
  gpsLongitude         Float?
  openingHours         String?
  socialLinks          Json?
  deliveryCoverage     String?
  announcementBanner   String?
  accentColor          String?
  storeTheme           String?
  acceptOrders         Boolean                  @default(true)
  vacationMode         Boolean                  @default(false)
  deliveryAvailable    Boolean                  @default(true)
  pickupAvailable      Boolean                  @default(true)
  chatEnabled          Boolean                  @default(true)
  callsEnabled         Boolean                  @default(true)
  seoTitle             String?
  seoDescription       String?
  logoUrl              String?
  coverUrl             String?
  isVerified           Boolean                  @default(false)
  verificationStatus   SellerVerificationStatus @default(NOT_SUBMITTED)
  responseRate         Int                      @default(0)
  trustScore           Int                      @default(50)
  ratingAverage        Float                    @default(0)
  ratingCount          Int                      @default(0)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  owner                User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products             Product[]
  reviews              Review[]
  verificationRequests SellerVerification[]
  foodMenuItems        FoodMenuItem[]
  foodOrders           FoodOrder[]
  marketplaceOrders    MarketplaceOrder[]
  followers            StoreFollower[]          @relation("StoreFollowerStore")
  deliveryRequests     DeliveryRequest[]
}

model StoreFollower {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())
  user      User     @relation("StoreFollowerUser", fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation("StoreFollowerStore", fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId, createdAt])
  @@index([userId, createdAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                    String                 @id @default(cuid())
  sellerId              String
  storeId               String?
  categoryId            String
  listingType           ListingType            @default(PRODUCT)
  priceMode             PriceMode              @default(FIXED)
  title                 String
  slug                  String                 @unique
  description           String
  brand                 String?
  sku                   String?
  tags                  String[]
  weightKg              Float?
  deliveryOptions       String?
  price                 Decimal                @db.Decimal(12, 2)
  salePrice             Decimal?               @db.Decimal(12, 2)
  saleStartsAt          DateTime?
  saleEndsAt            DateTime?
  quantity              Int                    @default(1)
  condition             ProductCondition       @default(USED)
  location              String                 @default("Dunkwa-on-Offin")
  area                  String?
  pickupNote            String?
  stockStatus           StockStatus            @default(AVAILABLE)
  listingStatus         ListingStatus          @default(PENDING)
  listingPaymentStatus  ListingPaymentStatus   @default(NOT_REQUIRED)
  approvalNote          String?
  rejectionReason       String?
  negotiable            Boolean                @default(true)
  allowCalls            Boolean                @default(true)
  allowWhatsapp         Boolean                @default(true)
  isFeatured            Boolean                @default(false)
  featuredUntil         DateTime?
  expiresAt             DateTime?
  renewedAt             DateTime?
  videoUrl              String?
  seoTitle              String?
  seoDescription        String?
  viewCount             Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  seller                User                   @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  store                 Store?                 @relation(fields: [storeId], references: [id], onDelete: SetNull)
  category              Category               @relation(fields: [categoryId], references: [id])
  images                ProductImage[]
  favorites             Favorite[]
  conversations         Conversation[]
  reports               Report[]
  reviews               Review[]
  comparedBy            ComparedProduct[]
  priceAlerts           PriceAlert[]
  priceHistory          ProductPriceHistory[]
  recentlyViewed        RecentlyViewed[]
  productViews          ProductView[]
  adminNotes            AdminNote[]
  boostRequests         ProductBoostRequest[]
  paymentTransactions   PaymentTransaction[]   @relation("ProductPayments")
  marketplaceOrderItems MarketplaceOrderItem[]

  @@index([listingStatus, location])
  @@index([categoryId])
  @@index([sellerId])
  @@index([listingType])
  @@index([priceMode])
  @@index([listingPaymentStatus])
  @@index([isFeatured, featuredUntil])
  @@index([saleStartsAt, saleEndsAt])
  @@index([expiresAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model FavoriteFolder {
  id        String     @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites Favorite[]

  @@unique([userId, name])
}

model Favorite {
  id        String          @id @default(cuid())
  userId    String
  productId String
  folderId  String?
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  folder    FavoriteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([folderId])
}

model Conversation {
  id             String             @id @default(cuid())
  productId      String
  buyerId        String
  sellerId       String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer          User               @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller         User               @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages       Message[]
  typingStatuses ChatTypingStatus[]

  @@unique([productId, buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  attachments    ChatAttachment[]
  reports        Report[]

  @@index([conversationId, createdAt])
}

model ChatAttachment {
  id         String   @id @default(cuid())
  messageId  String
  uploaderId String
  url        String
  type       String
  name       String?
  size       Int?
  createdAt  DateTime @default(now())
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  productId      String?
  messageId      String?
  reportedUserId String?
  reviewedById   String?
  reason         String
  details        String?
  status         ReportStatus @default(OPEN)
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reviewedBy     User?        @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
}

model BlockedUser {
  id          String   @id @default(cuid())
  blockedById String
  targetId    String
  reason      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  blockedBy   User     @relation("BlockedBy", fields: [blockedById], references: [id], onDelete: Cascade)
  target      User     @relation("BlockedTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([blockedById, targetId])
}

model SellerVerification {
  id           String                   @id @default(cuid())
  sellerId     String
  storeId      String?
  status       SellerVerificationStatus @default(PENDING)
  businessName String?
  documentUrl  String?
  notes        String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  seller       User                     @relation("SellerVerificationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  store        Store?                   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  reviewedBy   User?                    @relation("SellerVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([sellerId])
}

model Review {
  id        String   @id @default(cuid())
  authorId  String
  sellerId  String
  storeId   String?
  productId String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  seller    User     @relation("ReviewSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([authorId, sellerId, productId])
  @@index([sellerId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

model TrustedDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceId    String
  label       String?
  userAgent   String?
  platform    String?
  timezone    String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, lastSeenAt])
}

model SavedSearch {
  id            String   @id @default(cuid())
  userId        String
  name          String
  query         String?
  category      String?
  location      String?
  minPrice      Decimal? @db.Decimal(12, 2)
  maxPrice      Decimal? @db.Decimal(12, 2)
  alertsEnabled Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ComparedProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model PriceAlert {
  id            String           @id @default(cuid())
  userId        String
  productId     String
  targetPrice   Decimal?         @db.Decimal(12, 2)
  lastSeenPrice Decimal?         @db.Decimal(12, 2)
  status        PriceAlertStatus @default(ACTIVE)
  triggeredAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([status, createdAt])
}

model ProductPriceHistory {
  id        String   @id @default(cuid())
  productId String
  oldPrice  Decimal  @db.Decimal(12, 2)
  newPrice  Decimal  @db.Decimal(12, 2)
  changedAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, changedAt])
}

model ChatTypingStatus {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  isTyping       Boolean      @default(false)
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId, updatedAt])
}

model Town {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  region    String     @default("Central Region")
  latitude  Float?
  longitude Float?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  areas     TownArea[]
}

model TownArea {
  id        String   @id @default(cuid())
  townId    String
  name      String
  slug      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  town      Town     @relation(fields: [townId], references: [id], onDelete: Cascade)

  @@unique([townId, slug])
  @@index([townId, sortOrder])
}

model ProductBoostRequest {
  id                   String                @id @default(cuid())
  productId            String
  sellerId             String
  status               ProductBoostStatus    @default(REQUESTED)
  placement            AdvertPlacement       @default(HOMEPAGE)
  requestedFor         String?
  headline             String?
  durationDays         Int                   @default(7)
  feeAmount            Decimal?              @db.Decimal(12, 2)
  paymentStatus        AdvertPaymentStatus   @default(PENDING)
  feeReference         String?
  billingPackageId     String?
  startsAt             DateTime?
  endsAt               DateTime?
  note                 String?
  extensionStatus      AdvertExtensionStatus @default(NONE)
  extensionDays        Int?
  extensionNote        String?
  extensionRequestedAt DateTime?
  extensionReviewedAt  DateTime?
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller               User                  @relation("BoostRequester", fields: [sellerId], references: [id], onDelete: Cascade)
  reviewedBy           User?                 @relation("BoostReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  billingPackage       BillingPackage?       @relation(fields: [billingPackageId], references: [id], onDelete: SetNull)
  images               AdvertImage[]
  paymentTransactions  PaymentTransaction[]  @relation("AdvertPayments")

  @@index([status, createdAt])
  @@index([placement, status, startsAt, endsAt])
  @@index([billingPackageId])
  @@index([productId])
}

model AdvertImage {
  id             String              @id @default(cuid())
  boostRequestId String
  url            String
  alt            String?
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  boostRequest   ProductBoostRequest @relation(fields: [boostRequestId], references: [id], onDelete: Cascade)

  @@index([boostRequestId, sortOrder])
}

model BillingPackage {
  id             String                @id @default(cuid())
  name           String
  description    String?
  type           BillingPackageType
  price          Decimal               @db.Decimal(12, 2)
  currency       String                @default("GHS")
  durationDays   Int?
  listingCount   Int?
  placement      AdvertPlacement?
  isActive       Boolean               @default(true)
  sortOrder      Int                   @default(0)
  updatedById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  updatedBy      User?                 @relation("BillingPackageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  payments       PaymentTransaction[]
  advertRequests ProductBoostRequest[]

  @@index([type, isActive, sortOrder])
}

model PaymentTransaction {
  id                String               @id @default(cuid())
  userId            String
  packageId         String?
  provider          BillingProvider
  status            BillingPaymentStatus @default(PENDING)
  purpose           PaymentPurpose
  reference         String               @unique
  providerReference String?
  amount            Decimal              @db.Decimal(12, 2)
  currency          String               @default("GHS")
  checkoutUrl       String?
  productId         String?
  boostRequestId    String?
  rawPayload        Json?
  paidAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation("PaymentUser", fields: [userId], references: [id], onDelete: Cascade)
  package           BillingPackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  product           Product?             @relation("ProductPayments", fields: [productId], references: [id], onDelete: SetNull)
  boostRequest      ProductBoostRequest? @relation("AdvertPayments", fields: [boostRequestId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([packageId])
  @@index([productId])
  @@index([boostRequestId])
  @@index([provider, status])
  @@index([purpose, status])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  sessionId String?
  source    String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
}

model AdminNote {
  id           String   @id @default(cuid())
  authorId     String
  targetUserId String?
  productId    String?
  body         String
  createdAt    DateTime @default(now())
  author       User     @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetUser   User?    @relation("AdminNoteTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model AdminAuditLog {
  id         String      @id @default(cuid())
  actorId    String
  action     AuditAction
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime    @default(now())
  actor      User        @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([action, createdAt])
}

model AccountDeletionRequest {
  id        String         @id @default(cuid())
  userId    String
  reason    String?
  status    DeletionStatus @default(REQUESTED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IntegrationSetting {
  id               String              @id @default(cuid())
  provider         IntegrationProvider @unique
  enabled          Boolean             @default(false)
  publicConfig     Json?
  encryptedSecrets String?
  status           IntegrationStatus   @default(NOT_CONFIGURED)
  lastTestedAt     DateTime?
  lastTestMessage  String?
  updatedById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  updatedBy        User?               @relation("IntegrationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("PlatformSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model FoodMenuItem {
  id              String           @id @default(cuid())
  storeId         String
  status          FoodMenuStatus   @default(PENDING)
  name            String
  description     String?
  category        String?
  basePrice       Decimal          @db.Decimal(12, 2)
  imageUrl        String?
  prepMinutes     Int?
  deliveryMinutes Int?
  isSpicy         Boolean          @default(false)
  isVegetarian    Boolean          @default(false)
  isAvailable     Boolean          @default(true)
  rejectionReason String?
  approvedAt      DateTime?
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  options         FoodMenuOption[]
  orderItems      FoodOrderItem[]
  images          FoodMenuImage[]

  @@index([status, isAvailable])
  @@index([storeId, isAvailable])
}

model FoodMenuImage {
  id        String       @id @default(cuid())
  itemId    String
  url       String
  alt       String?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  item      FoodMenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
}

model FoodMenuOption {
  id        String       @id @default(cuid())
  itemId    String
  name      String
  price     Decimal      @db.Decimal(12, 2)
  createdAt DateTime     @default(now())
  item      FoodMenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model FoodOrder {
  id                       String              @id @default(cuid())
  storeId                  String
  buyerId                  String
  status                   FoodOrderStatus     @default(PENDING_PAYMENT)
  directPaymentStatus      DirectPaymentStatus @default(AWAITING_PAYMENT)
  buyerName                String?
  buyerPhone               String?
  deliveryAddress          String?
  deliveryNote             String?
  paymentReference         String?
  paymentProofUrl          String?
  buyerPaymentNote         String?
  sellerPaymentNote        String?
  paymentSubmittedAt       DateTime?
  paymentRejectedReason    String?
  estimatedDeliveryMinutes Int?
  totalAmount              Decimal             @db.Decimal(12, 2)
  paymentConfirmedAt       DateTime?
  outForDeliveryAt         DateTime?
  deliveredAt              DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  store                    Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  buyer                    User                @relation("FoodOrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  items                    FoodOrderItem[]
  deliveryRequests         DeliveryRequest[]
  deliveries               Delivery[]

  @@index([storeId, status])
  @@index([buyerId, createdAt])
  @@index([directPaymentStatus, createdAt])
}

model MarketplaceOrder {
  id                  String                 @id @default(cuid())
  buyerId             String
  sellerId            String
  storeId             String?
  status              MarketplaceOrderStatus @default(PENDING_PAYMENT)
  directPaymentStatus DirectPaymentStatus    @default(AWAITING_PAYMENT)
  buyerName           String?
  buyerPhone          String?
  deliveryAddress     String?
  deliveryNote        String?
  paymentReference    String?
  paymentProofUrl     String?
  buyerPaymentNote    String?
  sellerPaymentNote   String?
  paymentSubmittedAt  DateTime?
  paymentConfirmedAt  DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  totalAmount         Decimal                @db.Decimal(12, 2)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  buyer               User                   @relation("MarketplaceOrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller              User                   @relation("MarketplaceOrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  store               Store?                 @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items               MarketplaceOrderItem[]

  @@index([buyerId, createdAt])
  @@index([sellerId, status])
  @@index([storeId, createdAt])
  @@index([directPaymentStatus, createdAt])
}

model MarketplaceOrderItem {
  id        String           @id @default(cuid())
  orderId   String
  productId String?
  title     String
  slug      String?
  imageUrl  String?
  quantity  Int              @default(1)
  unitPrice Decimal          @db.Decimal(12, 2)
  lineTotal Decimal          @db.Decimal(12, 2)
  order     MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model RiderProfile {
  id                    String                  @id @default(cuid())
  userId                String                  @unique
  status                RiderVerificationStatus @default(DRAFT)
  availability          RiderAvailability       @default(OFFLINE)
  vehicleType           RiderVehicleType?
  profilePhotoUrl       String?
  ghanaCardUrl          String?
  licenseUrl            String?
  vehicleDocumentUrl    String?
  emergencyContactName  String?
  emergencyContactPhone String?
  momoName              String?
  momoNumber            String?
  bankName              String?
  bankAccountName       String?
  bankAccountNumber     String?
  latitude              Float?
  longitude             Float?
  lastLocationAt        DateTime?
  rejectionReason       String?
  suspensionReason      String?
  approvedAt            DateTime?
  reviewedById          String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  user                  User                    @relation("RiderUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy            User?                   @relation("RiderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  deliveryRequests      DeliveryRequest[]       @relation("RiderRequests")
  deliveries            Delivery[]              @relation("RiderDeliveries")
  locationPings         RiderLocationPing[]
  ratings               RiderRating[]
  reports               DeliveryReport[]        @relation("RiderReports")

  @@index([status, availability])
  @@index([vehicleType])
}

model DeliveryRequest {
  id                String                @id @default(cuid())
  foodOrderId       String?
  storeId           String?
  sellerId          String
  buyerId           String
  riderId           String?
  status            DeliveryRequestStatus @default(OPEN)
  pickupName        String?
  pickupPhone       String?
  pickupAddress     String
  pickupLatitude    Float?
  pickupLongitude   Float?
  deliveryName      String?
  deliveryPhone     String?
  deliveryAddress   String
  deliveryLatitude  Float?
  deliveryLongitude Float?
  productName       String
  deliveryFee       Decimal               @db.Decimal(12, 2)
  distanceKm        Float?
  estimatedMinutes  Int?
  note              String?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  foodOrder         FoodOrder?            @relation(fields: [foodOrderId], references: [id], onDelete: SetNull)
  store             Store?                @relation(fields: [storeId], references: [id], onDelete: SetNull)
  seller            User                  @relation("DeliveryRequestSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer             User                  @relation("DeliveryRequestBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  rider             RiderProfile?         @relation("RiderRequests", fields: [riderId], references: [id], onDelete: SetNull)
  delivery          Delivery?

  @@index([status, createdAt])
  @@index([riderId, status])
  @@index([foodOrderId])
  @@index([sellerId, createdAt])
  @@index([buyerId, createdAt])
}

model Delivery {
  id                String              @id @default(cuid())
  requestId         String              @unique
  riderId           String
  foodOrderId       String?
  sellerId          String
  buyerId           String
  status            DeliveryStatus      @default(WAITING_FOR_RIDER)
  deliveryFee       Decimal             @db.Decimal(12, 2)
  distanceKm        Float?
  estimatedMinutes  Int?
  acceptedAt        DateTime?
  headingToSellerAt DateTime?
  pickedUpAt        DateTime?
  onTheWayAt        DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  buyerConfirmedAt  DateTime?
  sellerConfirmedAt DateTime?
  riderLatitude     Float?
  riderLongitude    Float?
  riderLocationAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  request           DeliveryRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  rider             RiderProfile        @relation("RiderDeliveries", fields: [riderId], references: [id], onDelete: Cascade)
  foodOrder         FoodOrder?          @relation(fields: [foodOrderId], references: [id], onDelete: SetNull)
  seller            User                @relation("DeliverySeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer             User                @relation("DeliveryBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  locationPings     RiderLocationPing[]
  ratings           RiderRating[]
  reports           DeliveryReport[]

  @@index([riderId, status])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@index([foodOrderId])
}

model RiderLocationPing {
  id         String       @id @default(cuid())
  riderId    String
  deliveryId String?
  latitude   Float
  longitude  Float
  accuracy   Float?
  heading    Float?
  speed      Float?
  createdAt  DateTime     @default(now())
  rider      RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)
  delivery   Delivery?    @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([riderId, createdAt])
  @@index([deliveryId, createdAt])
}

model RiderRating {
  id         String       @id @default(cuid())
  deliveryId String
  riderId    String
  authorId   String
  rating     Int
  comment    String?
  createdAt  DateTime     @default(now())
  delivery   Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  rider      RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)
  author     User         @relation("RiderRatingAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, deliveryId])
  @@index([riderId, createdAt])
}

model DeliveryReport {
  id             String               @id @default(cuid())
  deliveryId     String
  riderId        String?
  reporterId     String
  reviewedById   String?
  reason         DeliveryReportReason
  details        String?
  status         ReportStatus         @default(OPEN)
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  delivery       Delivery             @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  rider          RiderProfile?        @relation("RiderReports", fields: [riderId], references: [id], onDelete: SetNull)
  reporter       User                 @relation("DeliveryReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy     User?                @relation("DeliveryReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([riderId, createdAt])
  @@index([reporterId, createdAt])
}

model FoodOrderItem {
  id        String       @id @default(cuid())
  orderId   String
  itemId    String
  name      String
  quantity  Int          @default(1)
  unitPrice Decimal      @db.Decimal(12, 2)
  options   Json?
  lineTotal Decimal      @db.Decimal(12, 2)
  order     FoodOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item      FoodMenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([itemId])
}
